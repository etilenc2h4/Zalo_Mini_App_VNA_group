# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU - ZALO MINI APP DU LỊCH ĐẮK SONG
# Sao chép file này thành .env để sử dụng:
#   cp .env.example .env (Linux/macOS) hoặc Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# 1. Mini App ID chính thức (Dùng để đóng gói và deploy qua zmp-cli lên nền tảng mini.zalo.me)
APP_ID=3383174999178410045

# 2. ID Ứng dụng Du Lịch Đắk Song Demo (Dùng cho ứng dụng liên kết / Zalo App)
DEMO_APP_ID=1428377454526174402

# 3. Token triển khai ZMP CLI (Tự động sinh khi chạy `zmp login`, dùng cho deploy tự động/CI-CD)
# ZMP_TOKEN=your_zmp_token_here

# 4. URL Cloudflare Worker Proxy cho Sa bàn thực tế ảo VR 360° Đắk Song
# (Dùng để giải quyết lỗi CORS và khắc phục file Leaflet 404 từ máy chủ gốc)
VITE_VR360_PROXY_URL=https://daksong-vr360-proxy.truonghaithang.workers.dev/

# 5. Cấu hình máy chủ API Cổng Du Lịch Đắk Song (Được đọc trực tiếp bởi src/services/apiConfig.ts)
# Mặc định kết nối backend Đắk Nông / Đắk Song:
VITE_API_BASE_URL=https://core-360.vnaapi.com
VITE_TENANT_API_BASE_URL=https://core-tenant.vnaapi.com
VITE_DEPARTMENT_CODE=DAKNONG-2-29
VITE_TENANT_CODE=DAKNONG
VITE_MEDIA_CDN_URL=https://static.dggv.edu.vn

# 6. Cấu hình Supabase (Dùng để lưu người dùng Zalo, đồng bộ Điểm yêu thích & Lịch trình tour)
# Đăng ký miễn phí tại https://supabase.com -> Tạo project -> Lấy URL & anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 7. Cấu hình Backend Core Riêng (Express Server - AI Orchestrator & Trip Scheduler)
# Khi test cục bộ: http://localhost:4000/api
# Khi deploy production/cloud: https://api.yourdomain.com/api (hoặc URL Ngrok)
VITE_BACKEND_API_URL=http://localhost:4000/api

